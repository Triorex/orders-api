# Supply-chain defaults for every npm command in this repo (local, CI and the image build).
# No install scripts: the 2025 npm worm ("Shai-Hulud") spread through them.
ignore-scripts=true
# 7-day release cooldown at resolve time (npm 11.10+), the same rule the curation gate enforces.
min-release-age=7
# Exact versions in package.json; package-lock.json pins every integrity hash.
save-exact=true
fund=false
update-notifier=false
